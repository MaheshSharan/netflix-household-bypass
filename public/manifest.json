{
  "manifest_version": 3,
  "name": "Netflix Household Bypass",
  "version": "0.1",
  "author": "Mahesh Sharan",
  "homepage_url": "https://github.com/MaheshSharan",
  "description": "Zero-race TypeScript bypass for Netflix household verification modals and network checks.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "webNavigation",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://web.prod.cloud.netflix.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Netflix Household Bypass",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
